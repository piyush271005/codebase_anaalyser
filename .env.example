# ==============================================================================
# AI Codebase Analyzer - Backend Environment Variables
# ==============================================================================

# LLM Provider Configuration ("groq", "gemini", "openai", "ollama")
LLM_PROVIDER=groq

# Groq API Configuration (Fast and high token limits)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Configuration (Used for Gemini LLM and Vector Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
# EMBEDDING_MODEL=gemini-embedding-001

# OpenAI API Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Local Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3
